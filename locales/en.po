msgstr "ask: confirm every action"

#: crates/termade-tui/src/settings.rs
msgid "auto：自動核准一般動作"
msgstr "auto: approve routine actions automatically"

#: crates/termade-tui/src/settings.rs
msgid "bypass：完全不問"
msgstr "bypass: never ask"

#: crates/termade-tui/src/settings.rs
msgid "未設定（agent 自己的預設）"
