msgstr "List symbol outlines and line ranges for source files or directories (Rust / TS / JS / Vue / C# / Python / Godot)"

#: src/cmd/helptext/help_strings.rs
msgid "列出所有 session"
msgstr "List all sessions"

#: src/cmd/helptext/help_strings.rs
msgid "列出所有協作任務"
msgstr "List all collaboration tasks"

