msgstr "Agent kind: opencode / claude / codex / antigravity; may include `:model` (e.g. claude:opus)"

#: src/cmd/helptext/help_strings.rs
msgid "Archive ended sessions that are merged or have no worktree"
msgstr "Archive ended sessions that are merged or have no worktree"

#: src/cmd/helptext/help_strings.rs
msgid "Only sessions of this project root (default: all projects)"
msgstr "Only sessions of this project root (default: all projects)"

#: src/cmd/helptext/help_strings.rs
msgid "Project directory (TUI default and session spawn cwd)"
msgstr "Project directory (TUI default and session spawn cwd)"

