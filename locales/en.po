msgid "Scope: here (this project only) / all (all projects, default)"
msgstr "Filter scope: here (this project only) / all (all projects, default)"

#: src/cmd/helptext/help_strings.rs
msgid "Session id 或標籤"
msgstr "Session id or label"

#: src/cmd/helptext/help_strings.rs
msgid "Web 版自訂連接埠 (預設 7421)"
msgstr "Custom port for Web version (default 7421)"

