msgstr "Install into the home directory (shared by all projects)"

#: src/cmd/helptext/help_strings.rs
msgid "安裝到目前專案 (預設)"
msgstr "Install into the current project (default)"

#: src/cmd/helptext/help_strings.rs
msgid "安裝／移除／顯示內嵌的 ertangle-ade skill"
msgstr "Install / uninstall / show the embedded ertangle-ade skill"

#: src/cmd/helptext/help_strings.rs
msgid "寄件者 session id (預設讀 ERTANGLE_SESSION 環境變數)"
msgstr "Sender session id (defaults to the ERTANGLE_SESSION environment variable)"

