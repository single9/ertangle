msgid "在背景啟動開發伺服器 (自動分配空閒連接埠並等待就緒)"
msgstr "Start the dev server in the background (auto-assigns a free port and waits until ready)"

#: src/cmd/helptext/help_strings.rs
msgid "執行期切換 session 的 model 與／或 effort (下一個回合起生效)"
msgstr "Switch a session's model and/or effort at runtime (takes effect from the next turn)"

#: src/cmd/helptext/help_strings.rs
msgid "執行跨語言低雜訊建置、型別與測試檢查 (Rust / Node / Vite / .NET Core / Python / Godot)"
msgstr "Run low-noise polyglot build, type, and test verification (Rust / Node / Vite / .NET Core / Python / Godot)"

#: src/cmd/helptext/help_strings.rs crates/ertangle-tui/src/commands.rs
